# Esuno environment template. Copy to `.env` at installation and adjust:
#   cp deploy/env.example .env
# Configure all storage paths, then bootstrap as in docs/deployment/production.md.
# This file must never contain real secrets. Database and mail administrator
# passwords are generated on first start into the `secrets` volume.

# --- Public addresses ---------------------------------------------------------
# Caddy site address. A real domain (mail.example.com) gets a Let's Encrypt
# certificate; `localhost` uses Caddy's local certificate authority.
OPENSUITE_SITE_ADDRESS=localhost
# Host name clients use for HTTPS links (JMAP session URLs).
OPENSUITE_PUBLIC_HOST=localhost
# Optional separate application origins; mail stays the sign-in origin. See
# "Separate application origins" in docs/deployment/production.md.
#AUTH_PRODUCT_ORIGINS=drive=https://drive.example.com,calendar=https://calendar.example.com
# Every origin serving the web application (defaults to the public host).
#DRIVE_TRUSTED_ORIGINS=https://mail.example.com,https://drive.example.com,https://calendar.example.com
# Mail server host name (SMTP greeting, message IDs).
MAIL_HOSTNAME=localhost
# Primary domain for new mailbox accounts.
MAIL_DOMAIN=localhost.test
# Further account domains, comma separated (managed domains are also accepted).
#MAIL_DOMAINS=example.net
# Cloud: required list of account domains available to subscribers. Optional
# for self-hosted; empty preserves the unrestricted domain choices.
SUBSCRIBER_DOMAINS=
# Maximum mailbox addresses per user, including the primary address.
ADDRESS_PER_USER_CAP=50

# --- Published ports ----------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# No direct SMTP port is published; see the emergency override in the docs.
# Mail protocols stay loopback-only until the certificate is installed and
# verified; set to 0.0.0.0 only after completing that procedure.
MAIL_PROTOCOL_BIND=127.0.0.1
# Message submission over implicit TLS (RFC 8314).
SUBMISSIONS_PORT=465
# IMAP over implicit TLS.
IMAPS_PORT=993
MANAGESIEVE_PORT=4190

# Dedicated internal network for management credentials. Choose a private
# subnet that does not overlap any host or Docker network before bootstrapping.
MAIL_MANAGEMENT_SUBNET=172.30.248.0/24
# All addresses must be distinct, free and inside the management subnet.
MAIL_MANAGEMENT_API_IP=172.30.248.10
MAIL_MANAGEMENT_STALWART_IP=172.30.248.20
MAIL_MANAGEMENT_SETUP_IP=172.30.248.21
MAIL_MANAGEMENT_OPS_IP=172.30.248.22
MAIL_MANAGEMENT_BACKUP_IP=172.30.248.23
MAIL_MANAGEMENT_BOOTSTRAP_IP=172.30.248.24

# Distinct free addresses in the existing 172.28.254.0/24 API proxy subnet.
API_PROXY_CADDY_IP=172.28.254.2
API_PROXY_API_IP=172.28.254.3

# Stalwart file references maintained by the Caddy certificate renewal timer.
# Set these paths and enable only after following the certificate procedure.
MAIL_TLS_ENABLED=0
MAIL_TLS_CERT_FILE=/dev/null
MAIL_TLS_KEY_FILE=/dev/null

# --- Application database -----------------------------------------------------
POSTGRES_USER=opensuite
POSTGRES_DB=opensuite
# Separate database for the file storage service.
POSTGRES_DRIVE_DB=opensuite_drive

# --- Mail blob storage --------------------------------------------------------
# The default keeps blobs in local RocksDB. For a new installation or after
# migrating existing blobs, follow docs/operations/object-storage.md.
MAIL_BLOB_STORE=local
MAIL_S3_ENDPOINT=
MAIL_S3_REGION=
MAIL_S3_BUCKET=
# Include a trailing slash if a directory-like prefix is desired.
MAIL_S3_PREFIX=
MAIL_S3_KEY_ID=
# Absolute host path to an operator-provided secret file, readable by uid 2000.
# Do not place the secret itself in this file or in Git.
MAIL_S3_SECRET_FILE=/dev/null
# Set to 1 only for the initial switch after verifying/migrating existing blobs.
MAIL_S3_ALLOW_SWITCH=0

# --- Drive object storage -----------------------------------------------------
# Production: both endpoints are https://s3.<region>.backblazeb2.com.
# The public endpoint must be reachable by browsers without rewriting the host.
DRIVE_S3_ENDPOINT=
DRIVE_S3_PUBLIC_ENDPOINT=
DRIVE_S3_BUCKET=
DRIVE_S3_PREFIX=drive/
DRIVE_S3_REGION=
DRIVE_S3_ACCESS_KEY=
# Absolute host path, readable by the Drive container uid 999, no newline.
DRIVE_S3_SECRET_FILE=
DRIVE_S3_PATH_STYLE=true

# --- SES outbound relay -------------------------------------------------------
# Set to 1 after applying the relay. Stalwart fails startup if its secret is empty.
MAIL_RELAY_CONFIGURED=0
# Absolute host path readable by uid 2000; never put the password in .env.
MAIL_RELAY_SECRET_FILE=/dev/null

# --- Encrypted backups -------------------------------------------------------
# Configure the separate backup credentials and encryption key outside .env;
# see docs/operations/backup.md before enabling the daily systemd timer.

# --- Optional domain management ----------------------------------------------
# Disabled when unset. The rule must exist in the active regional SES rule set.
DOMAINS_SES_ENABLED=
DOMAINS_SES_RULE=
DOMAINS_SES_RULE_SET=
# Explicit read-only adoption mode and comma-separated approved domains.
DOMAINS_SES_MODE=
DOMAINS_ADOPT_DOMAINS=
# Local substitutes only; leave empty for AWS.
DOMAINS_SES_ENDPOINT=
# Host path to a JSON file with accessKeyId, secretAccessKey and optional
# sessionToken, readable by API container uid 1000. Never put credentials here.
DOMAINS_SES_CREDENTIALS_FILE=
# The origin must be reachable on the mail-management network. The generated
# management password is mounted at the example container path below.
DOMAINS_STALWART_ORIGIN=
DOMAINS_STALWART_USER=
DOMAINS_STALWART_PASSWORD_FILE=
# Example: /run/opensuite/stalwart-management/password
# Empty uses the default one-hour verification interval.
DOMAINS_CHECK_INTERVAL_SECONDS=

# --- API server (also read by `pnpm --filter @opensuite/api dev`) -------------
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Leave self-hosted selected until billing setup and account migration finish.
ESUNO_DEPLOYMENT_MODE=self-hosted
# Optional local Drive quota. Leave empty for no Esuno-imposed limit.
DRIVE_QUOTA_BYTES=
# Cloud requires these host paths, readable by API uid 1000. The internal token
# is generated by Compose unless an operator supplies a host file readable by
# both API uid 1000 and Drive uid 999.
STRIPE_SECRET_KEY_FILE=
STRIPE_WEBHOOK_SECRET_FILE=
BILLING_INTERNAL_TOKEN_FILE=
DRIVE_ENTITLEMENTS_TOKEN_FILE=
STRIPE_AUTOMATIC_TAX=true
# Public website cancel URL; its HTTPS origin may initiate public Checkout.
BILLING_CANCEL_URL=
# Domain of accounts created by a paid public checkout (default MAIL_DOMAIN).
# Must be an account domain and, in Cloud, in SUBSCRIBER_DOMAINS.
BILLING_ACCOUNT_DOMAIN=
# For the operator-run setup script (not passed to containers).
STRIPE_WEBHOOK_URL=
# Per-dependency budget for GET /ready, in milliseconds (50-30000).
READINESS_TIMEOUT_MS=2000

# --- Development profile only (`docker compose --profile dev up -d`) ---------
# LocalStack stands in for S3/SQS; no AWS account or credentials are needed.
# 4.14.0 is the last LocalStack release that starts without an account. Newer
# images need LOCALSTACK_AUTH_TOKEN (a LocalStack account, not AWS).
LOCALSTACK_IMAGE=localstack/localstack:4.14.0@sha256:3ebc37595918b8accb852f8048fef2aff047d465167edd655528065b07bc364a
LOCALSTACK_AUTH_TOKEN=
INBOUND_BUCKET=opensuite-inbound
INBOUND_QUEUE=opensuite-inbound

# Observability: see docs/operations/observability.md for protected env files,
# backup marker and webhook setup. Both paths must already exist on the host.
OBSERVE_BACKUP_DIR=./deploy/backup-status
OBSERVE_DISK_PATH=/var/lib/docker
# Optional profile: put ingestion secrets in this protected file.
INGEST_ENV_FILE=./deploy/ingest.env
OBSERVE_ENV_FILE=./deploy/observe.env

# --- Optional project website ---------------------------------------------
# Serves the static site built from apps/landing on its own origin, for
# example "esuno.net, www.esuno.net" (www redirects to the bare name).
#LANDING_SITE_ADDRESS=landing.localhost

# --- Optional Esuno Vault profile -----------------------------------------
# Only used with the vault profile. Dedicated hostname shared by Caddy and
# Vaultwarden; it must differ from OPENSUITE_SITE_ADDRESS. HTTPS_PORT must be 443.
# For upgrades that should include Vault, set COMPOSE_PROFILES=vault in .env.
VAULT_PUBLIC_HOST=vault.localhost
# Choose a non-overlapping subnet and an IP outside its dynamic range.
VAULT_NETWORK_SUBNET=172.28.253.0/24
VAULT_NETWORK_IP_RANGE=172.28.253.128/25
VAULT_CADDY_IP=172.28.253.2
# Override with a verified version and digest for upgrades or rollback.
VAULT_IMAGE=vaultwarden/server:1.37.4@sha256:efb3cde962015fcc036b2ea625242248611943b27212ebf4392841fb30fad055
# The admin listener is always bound to 127.0.0.1; see operations/vault.md.
VAULT_ADMIN_PORT=8081
# An absolute path to an operator-generated Argon2 PHC file, or /dev/null to
# leave the admin interface disabled. Do not put the token itself in .env.
# Admin, SMTP and push files must be readable by uid 1000.
VAULT_ADMIN_TOKEN_FILE=/dev/null
# Explicitly allow restricted signup and admin settings in saved configuration.
VAULT_ALLOW_SAVED_SIGNUPS=false
VAULT_SIGNUPS_ALLOWED=false
VAULT_INVITATIONS_ALLOWED=true
# `none` disables organization creation; list authorized email addresses to allow it.
VAULT_ORG_CREATION_USERS=none
VAULT_LOGIN_RATELIMIT_SECONDS=60
VAULT_LOGIN_RATELIMIT_MAX_BURST=10
VAULT_ADMIN_RATELIMIT_SECONDS=300
VAULT_ADMIN_RATELIMIT_MAX_BURST=3
# Optional SES SMTP (STARTTLS). Supply a host-readable password file, not a
# password in .env. Leave the host empty to disable SMTP.
VAULT_SMTP_HOST=
VAULT_SMTP_PORT=2587
VAULT_SMTP_SECURITY=starttls
VAULT_SMTP_FROM=
VAULT_SMTP_USERNAME=
VAULT_SMTP_SECRET_FILE=/dev/null

# Optional YubiKey OTP validation in Vaultwarden. TOTP and FIDO2 do not need these.
VAULT_YUBICO_CLIENT_ID=
VAULT_YUBICO_SECRET_KEY=
# Optional alternative to the environment variable, readable by uid 1000.
VAULT_YUBICO_SECRET_FILE=/dev/null
# Optional Bitwarden mobile push relay; see the operations guide.
VAULT_PUSH_ENABLED=false
VAULT_PUSH_INSTALLATION_ID=
VAULT_PUSH_KEY_FILE=/dev/null
VAULT_PUSH_RELAY_URI=https://push.bitwarden.com
VAULT_PUSH_IDENTITY_URI=https://identity.bitwarden.com

# Web Push VAPID keys are generated in the secrets volume by the secrets service.
# The API receives read-only VAPID_PUBLIC_KEY_FILE and VAPID_PRIVATE_KEY_FILE
# mounts through Compose; do not put key values in this file.

# Optional prebuilt image for the one-shot database migration job.
#OPENSUITE_MIGRATE_IMAGE=opensuite-migrate:local
