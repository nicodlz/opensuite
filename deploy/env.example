# OpenSuite environment template. Copy to `.env` at installation and adjust.
# This file must never contain real secrets.

# API server
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Per-dependency budget for GET /ready, in milliseconds (50-30000).
READINESS_TIMEOUT_MS=2000
