{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
