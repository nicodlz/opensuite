{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "test-support/**/*.ts",
        "test-support/**/*.mjs",
        "scripts/*.mjs"
      ]
    },
    "apps/*": {},
    "packages/*": {},
    "apps/web": {
      "entry": ["src/styles.css"]
    },
    "apps/api": {
      "entry": ["src/bootstrap.ts"]
    },
    "apps/drive": {
      "ignoreDependencies": ["@prisma/client"]
    }
  }
}
