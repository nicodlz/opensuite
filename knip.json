{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "test-support/**/*.ts",
        "test-support/**/*.mjs",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": ["@bitwarden/cli", "@types/mailparser"]
    },
    "apps/*": {},
    "packages/*": {},
    "apps/web": {
      "entry": ["src/styles.css", "public/push-sw-v1.js"]
    },
    "apps/api": {
      "entry": ["src/bootstrap.ts"],
      "ignoreDependencies": ["stripe"]
    },
    "apps/drive": {
      "ignoreDependencies": ["@prisma/client"]
    }
  }
}
