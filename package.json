{
  "name": "opensuite",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json && tsc -p e2e/tsconfig.json",
    "lint": "oxlint -c packages/oxlint-config/oxlintrc.json --max-warnings=0",
    "format": "prettier --ignore-path .prettierignore --ignore-path .gitignore --ignore-path packages/db/.gitignore --write .",
    "format:check": "prettier --ignore-path .prettierignore --ignore-path .gitignore --ignore-path packages/db/.gitignore --check .",
    "knip": "knip",
    "test": "vitest run --project unit",
    "build": "pnpm --filter @opensuite/web --filter @opensuite/landing build",
    "test:e2e": "playwright test",
    "iac:validate": "node scripts/iac-validate.mjs",
    "icons:generate": "node apps/web/generate-icons.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@bitwarden/cli": "catalog:",
    "@noble/hashes": "catalog:",
    "@opensuite/core": "workspace:*",
    "@opensuite/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/mailparser": "^3.9.0",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "mailparser": "^3.14.1",
    "neverthrow": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
