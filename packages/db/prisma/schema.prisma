generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth's core schema: https://better-auth.com/docs/concepts/database
model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  twoFactorEnabled Boolean           @default(false)
  role             String            @default("user")
  disabled         Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  domains          Domain[]
  addresses        Address[]
  providers        ProviderConfig[]
  ingestions       IngestionRecord[]
  auditEvents      AuditEvent[]
  twoFactor        TwoFactor?
  securityKeys     SecurityKey[]
  mailbox          MailboxLink?
  mailboxProvision MailboxProvision?
  aliasSyncToken String?
  aliasSyncUntil DateTime?
  emailAliases     EmailAlias[]
  aliasApiKeys     AliasApiKey[]
  pushSubscriptions PushSubscription[]
  pushTags PushTag[]
  mailPushState MailPushState?
  calendarReminders CalendarReminder[]
  calendarReminderSync CalendarReminderSync?
  pushShowDetails Boolean @default(false)
  calendarTimeZone String @default("UTC")
  defaultAliasDomainId String?
  defaultAliasDomain Domain? @relation("DefaultAliasDomain", fields: [defaultAliasDomainId], references: [id], onDelete: Restrict)
  billingCustomer BillingCustomer?
  subscriptions Subscription[]
}

model SecurityKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[]
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model MailboxProvision {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId String?
  address   String?
  state     String   @default("pending")
  updatedAt DateTime @updatedAt
}

model TwoFactor {
  id                      String    @id
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
}

model MailboxLink {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId    String   @unique
  address      String   @unique
  credentialId String
  secret       String
  status       String   @default("active")
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Domain {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String    @unique
  stalwartId String?
  status String @default("pending")
  removalPending Boolean @default(false)
  adoptionFailureCount Int @default(0)
  records Json @default("[]")
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  addresses Address[]
  defaultForUsers User[] @relation("DefaultAliasDomain")
  emailAliases EmailAlias[]

  @@unique([id, userId])
  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  localPart String
  isAlias   Boolean  @default(false)
  createdAt DateTime @default(now())
  emailAlias EmailAlias?
  mailboxManaged Boolean @default(false)
  ready Boolean @default(false)
  removalPending Boolean @default(false)
  lastAccountId String?
  revision Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([mailboxManaged, ready, updatedAt])
  @@unique([domainId, localPart])
  @@index([userId])
}

model EmailAlias {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  domainId String
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  addressId String @unique
  addressRecord Address @relation(fields: [addressId], references: [id], onDelete: Restrict)
  address String @unique
  localPart String
  website String?
  note String?
  enabled Boolean @default(true)
  ready Boolean @default(false)
  detachedByDomain Boolean @default(false)
  suspended Boolean @default(false)
  lastAccountId String?
  revision Int @default(0)
  requestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([userId, requestId])
  @@index([userId])
}

model AliasApiKey {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String
  prefix String @unique
  secretHash String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?

  @@index([userId])
}

model ProviderConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String
  // Versioned authenticated ciphertext; never store provider secrets in plaintext.
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model IngestionRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  detail    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// The envelope must remain recoverable even when no local user matches it.
model InboundMessage {
  id             String             @id
  bucket         String
  objectKey      String
  notification   Json
  state          String             @default("received")
  receivedAt     DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  recipients     InboundRecipient[]
}

model InboundRecipient {
  idempotencyKey String         @id
  messageId      String
  message        InboundMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  destination    String
  addresses      Json
  state          String         @default("received")
  attempts       Int            @default(0)
  remoteId       String?
  claimedAt      DateTime?
  claimOwner     String?
  importStartedAt DateTime?
  legacy         Boolean        @default(false)
  permanent      Boolean        @default(false)
  error          String?
  updatedAt      DateTime       @updatedAt

  @@index([messageId])
}

model InboundResolutionAudit {
  id             String   @id @default(cuid())
  recipientKey   String
  operator       String
  reason         String
  action         String
  previousState  String
  remoteId       String?
  createdAt      DateTime @default(now())

  @@index([recipientKey])
}

model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product String
  endpoint String @unique
  p256dh String
  auth String
  userAgent String
  createdAt DateTime @default(now())
  lastSuccessAt DateTime?
  failureCount Int @default(0)
  nextAttemptAt DateTime?
  vapidFingerprint String?
  sessionId String?
  @@index([userId, product])
  @@index([userId, sessionId])
}

model PushTag {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product String
  tag String
  expiresAt DateTime
  @@id([userId, product, tag])
  @@index([expiresAt])
}

model MailPushState {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation String
  accountId String
  state String?
  leaseToken String?
  leaseUntil DateTime?
}

model CalendarReminderSync {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner String?
  leaseUntil DateTime?
  lastSyncedAt DateTime?
}

model CalendarReminder {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId String
  eventId String
  uid String
  occurrenceId String
  recurrenceKey String
  alarmId String
  occurrenceStart DateTime
  triggerAt DateTime
  title String
  location String
  timeZone String
  allDay Boolean
  state String @default("pending")
  claimOwner String?
  claimUntil DateTime?
  nextAttemptAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([userId, uid, recurrenceKey, alarmId, occurrenceStart], map: "calendar_reminder_identity_key")
  @@index([state, triggerAt])
  @@index([state, updatedAt])
  @@index([userId, state])
}

// Managed Cloud billing. Stripe is the source of truth: rows are refreshed from
// the Stripe API after a verified webhook, never from client input. No payment
// card data is stored.
model BillingCustomer {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

model Subscription {
  // The Stripe subscription ID.
  id                 String    @id
  // Null until a checkout started without an account is claimed.
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeCustomerId   String
  plan               String
  interval           String
  status             String
  priceId            String
  storageQuotaBytes  BigInt
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  endedAt            DateTime?
  latestInvoiceStatus String?
  // Stripe's own timestamp of the state stored here; older reads never win.
  stripeObservedAt   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  @@index([userId, status])
  @@index([stripeCustomerId])
}

model StripeEvent {
  id          String    @id
  type        String
  createdAt   DateTime
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  @@index([processedAt, receivedAt])
}

// A paid checkout started from the public site, before an account exists.
model CheckoutClaim {
  sessionId        String    @id
  stripeCustomerId String
  subscriptionId   String    @unique
  claimedByUserId  String?   @unique
  claimedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
}
