generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth's core schema: https://better-auth.com/docs/concepts/database
model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  twoFactorEnabled Boolean           @default(false)
  role             String            @default("user")
  disabled         Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  domains          Domain[]
  addresses        Address[]
  providers        ProviderConfig[]
  ingestions       IngestionRecord[]
  auditEvents      AuditEvent[]
  twoFactor        TwoFactor?
  mailbox          MailboxLink?
  mailboxProvision MailboxProvision?
  emailAliases     EmailAlias[]
  aliasApiKeys     AliasApiKey[]
  defaultAliasDomainId String?
  defaultAliasDomain Domain? @relation("DefaultAliasDomain", fields: [defaultAliasDomainId], references: [id], onDelete: Restrict)
}

model MailboxProvision {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId String?
  address   String?
  state     String   @default("pending")
  updatedAt DateTime @updatedAt
}

model TwoFactor {
  id                      String    @id
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
}

model MailboxLink {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId    String   @unique
  address      String   @unique
  credentialId String
  secret       String
  status       String   @default("active")
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Domain {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String    @unique
  stalwartId String?
  status String @default("pending")
  records Json @default("[]")
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  addresses Address[]
  enabled Boolean @default(true)
  defaultForUsers User[] @relation("DefaultAliasDomain")
  emailAliases EmailAlias[]

  @@unique([id, userId])
  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  localPart String
  isAlias   Boolean  @default(false)
  createdAt DateTime @default(now())
  emailAlias EmailAlias?

  @@unique([domainId, localPart])
  @@index([userId])
}

model EmailAlias {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  domainId String
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  addressId String @unique
  addressRecord Address @relation(fields: [addressId], references: [id], onDelete: Restrict)
  address String @unique
  localPart String
  website String?
  note String?
  enabled Boolean @default(true)
  ready Boolean @default(false)
  requestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([userId, requestId])
  @@index([userId])
}

model AliasApiKey {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String
  prefix String @unique
  secretHash String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?

  @@index([userId])
}

model ProviderConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String
  // Versioned authenticated ciphertext; never store provider secrets in plaintext.
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model IngestionRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  detail    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// The envelope must remain recoverable even when no local user matches it.
model InboundMessage {
  id             String             @id
  bucket         String
  objectKey      String
  notification   Json
  state          String             @default("received")
  receivedAt     DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  recipients     InboundRecipient[]
}

model InboundRecipient {
  idempotencyKey String         @id
  messageId      String
  message        InboundMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  destination    String
  addresses      Json
  state          String         @default("received")
  attempts       Int            @default(0)
  remoteId       String?
  claimedAt      DateTime?
  claimOwner     String?
  importStartedAt DateTime?
  legacy         Boolean        @default(false)
  permanent      Boolean        @default(false)
  error          String?
  updatedAt      DateTime       @updatedAt

  @@index([messageId])
}

model InboundResolutionAudit {
  id             String   @id @default(cuid())
  recipientKey   String
  operator       String
  reason         String
  action         String
  previousState  String
  remoteId       String?
  createdAt      DateTime @default(now())

  @@index([recipientKey])
}
